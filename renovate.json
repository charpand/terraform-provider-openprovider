{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "rebaseWhen": "behind-base-branch",
  "reviewers": ["dsdeboer"],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "matchManagers": ["gomod"],
      "matchPackagePrefixes": ["golang.org/x/"],
      "groupName": "golang-x",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["gomod"],
      "matchPackagePrefixes": ["google.golang.org/"],
      "groupName": "google-golang",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["gomod"],
      "matchPackagePrefixes": ["github.com/hashicorp/"],
      "groupName": "hashicorp",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["gomod"],
      "excludePackagePrefixes": [
        "golang.org/x/",
        "google.golang.org/",
        "github.com/hashicorp/"
      ],
      "groupName": "Go dependencies",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "Terraform",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "groupName": "renovate self-hosted image",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the pinned Renovate version in the workflow up to date",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.ya?ml$/"
      ],
      "matchStrings": [
        "renovate-version:\\s*(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/renovatebot/renovate"
    }
  ]
}
